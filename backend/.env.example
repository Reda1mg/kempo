# .env.example (fichier d'exemple)
# =================================
# Configuration de sécurité Kempo
# =================================

# Clé de chiffrement (générer une nouvelle clé pour chaque installation)
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Configuration base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kempo_collab
DB_USER=root
DB_PASSWORD=your-secure-password

# Configuration sécurité
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOG=true
SECURITY_LEVEL=high

# Sauvegarde automatique
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_PATH=./backups

# Authentification locale (optionnel)
ADMIN_PASSWORD=your-admin-password
ENABLE_AUTH=false
